<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Projekt9.ViewModels"
             xmlns:m="using:Projekt9.Models"
             x:Class="Projekt9.Views.SavedFormsView"
             x:DataType="vm:SavedFormsViewModel">

    <Grid RowDefinitions="Auto,*">
        <!-- Górny pasek -->
        <Border Grid.Row="0" Background="#0F2233" Padding="16,12">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                <TextBlock Grid.Column="0" Text="📂 Zapisane formularze"
                           FontSize="18" FontWeight="Bold" Foreground="White"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text=""/>
                <Button Grid.Column="2" Content="🔄 Odśwież"
                        Command="{Binding RefreshCommand}"
                        Padding="12,8"/>
                <Button Grid.Column="3" Content="← Powrót"
                        Command="{Binding BackCommand}"
                        Padding="12,8"/>
            </Grid>
        </Border>

        <!-- Pusta baza -->
        <Border Grid.Row="1" IsVisible="{Binding IsEmpty}"
                Background="#11000000" Padding="40">
            <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="📭" FontSize="48" HorizontalAlignment="Center"/>
                <TextBlock Text="Brak zapisanych formularzy w bazie."
                           HorizontalAlignment="Center" Opacity="0.8"/>
                <TextBlock Text="Wypełnij i zapisz pierwszy formularz, aby pojawił się tutaj."
                           HorizontalAlignment="Center" Opacity="0.6"/>
            </StackPanel>
        </Border>

        <!-- Master / Detail -->
        <Grid Grid.Row="1" IsVisible="{Binding HasEntries}"
              ColumnDefinitions="320,*" ColumnSpacing="0">
            <!-- LISTA -->
            <Border Grid.Column="0" Background="#11000000" Padding="0">
                <ListBox ItemsSource="{Binding Entries}"
                         SelectedItem="{Binding Selected}"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="m:FormEntry">
                            <StackPanel Spacing="2" Margin="6">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="{Binding FullName}" Opacity="0.85" FontSize="12"/>
                                <StackPanel Orientation="Horizontal" Spacing="6" Opacity="0.6">
                                    <TextBlock Text="#"/>
                                    <TextBlock Text="{Binding Id}"/>
                                    <TextBlock Text="•"/>
                                    <TextBlock Text="{Binding CreatedAt}"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- PODGLĄD -->
            <ScrollViewer Grid.Column="1" Padding="32,20,32,40"
                          Background="White"
                          VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Styles>
                    <!-- Wymuszamy ciemny tekst na białej "kartce" niezależnie od motywu. -->
                    <Style Selector="TextBlock">
                        <Setter Property="Foreground" Value="#101010"/>
                    </Style>
                </ScrollViewer.Styles>

                <Grid>
                    <!-- Komunikat, gdy nic nie wybrano -->
                    <TextBlock IsVisible="{Binding !HasSelection}"
                               Text="Wybierz formularz z listy, aby zobaczyć podgląd."
                               Opacity="0.6" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Margin="0,40"/>

                    <!-- Pełny podgląd zaznaczonego wpisu -->
                    <ContentControl IsVisible="{Binding HasSelection}"
                                    Content="{Binding Selected}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate DataType="m:FormEntry">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Center"
                                Spacing="10">
                        <!-- Meta -->
                        <Border Background="#F2F4F6" Padding="14,10" CornerRadius="8">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Nazwa:" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Name}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8" Opacity="0.7">
                                    <TextBlock Text="Id:"/>
                                    <TextBlock Text="{Binding Id}"/>
                                    <TextBlock Text="•"/>
                                    <TextBlock Text="Zapisano:"/>
                                    <TextBlock Text="{Binding CreatedAt}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Nagłówek wniosku -->
                        <TextBlock Text="POLITECHNIKA POZNAŃSKA" FontSize="22" FontWeight="Bold"
                                   Foreground="#1F6E84" HorizontalAlignment="Center" Margin="0,8"/>

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="1">
                                <Run Text="Poznań, dnia "/>
                                <Run Text="{Binding RequestDate}" FontWeight="Bold"/>
                            </TextBlock>
                        </Grid>

                        <!-- Pola 2..5 -->
                        <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto"
                              ColumnSpacing="14" RowSpacing="6">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="numer albumu"
                                       FontStyle="Italic" Opacity="0.7"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AlbumNumber}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="nazwisko i imię"
                                       FontStyle="Italic" Opacity="0.7"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FullName}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="semestr, rok"
                                       FontStyle="Italic" Opacity="0.7"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SemesterYear}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="kierunek i stopień studiów"
                                       FontStyle="Italic" Opacity="0.7"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding FieldAndDegree}"/>
                        </Grid>

                        <StackPanel HorizontalAlignment="Center" Margin="0,8">
                            <TextBlock Text="PRODZIEKAN WYDZIAŁU" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="INFORMATYKI I TELEKOMUNIKACJI" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="WNIOSEK O PRZEPROWADZENIE EGZAMINU KOMISYJNEGO"
                                   FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4"/>

                        <TextBlock Text="Proszę o umożliwienie mi przystąpienia do egzaminu komisyjnego z"
                                   TextWrapping="Wrap"/>

                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                            <TextBlock Grid.Column="0" Text="przedmiotu:" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding Subject}" TextWrapping="Wrap"/>
                            <TextBlock Grid.Column="2" Text="punkty:" FontWeight="SemiBold" Margin="10,0,0,0"/>
                            <TextBlock Grid.Column="3" Text="{Binding Points}"/>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <TextBlock Grid.Column="0" Text="prowadzonego przez:" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding Lecturer}" TextWrapping="Wrap"/>
                        </Grid>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Uzasadnienie wniosku:" FontWeight="Bold"/>
                            <Border Background="#F7F7F7" CornerRadius="4" Padding="10">
                                <TextBlock Text="{Binding Justification}" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                            <TextBlock Grid.Column="1">
                                <Run Text="Data podpisu: "/>
                                <Run Text="{Binding StudentSignDate}" FontWeight="Bold"/>
                                <Run Text="    Podpis studenta: "/>
                                <Run Text="{Binding StudentSignature}" FontWeight="Bold"/>
                            </TextBlock>
                        </Grid>

                        <Border BorderBrush="#888" BorderThickness="0,1,0,0" Margin="0,12,0,4"/>

                        <!-- DECYZJA -->
                        <TextBlock Text="DECYZJA" FontWeight="Bold" FontSize="16"
                                   HorizontalAlignment="Center" TextDecorations="Underline" Margin="0,4"/>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Decyzja prodziekana:" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding DecisionApproved, Converter={x:Static vm:DecisionTextConverter.Instance}}"/>
                        </StackPanel>

                        <TextBlock Text="Skład komisji:" FontWeight="Bold" Margin="0,4,0,0"/>
                        <StackPanel Spacing="2" Margin="14,0,0,0">
                            <TextBlock>
                                <Run Text="1. "/>
                                <Run Text="{Binding CommitteeMember1}"/>
                            </TextBlock>
                            <TextBlock>
                                <Run Text="2. "/>
                                <Run Text="{Binding CommitteeMember2}"/>
                            </TextBlock>
                            <TextBlock>
                                <Run Text="3. "/>
                                <Run Text="{Binding CommitteeMember3}"/>
                            </TextBlock>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,*" Margin="0,12,0,0">
                            <TextBlock Grid.Column="0">
                                <Run Text="Poznań, dnia "/>
                                <Run Text="{Binding DecisionDate}" FontWeight="Bold"/>
                            </TextBlock>
                            <TextBlock Grid.Column="1" Text="Pieczątka i podpis"
                                       HorizontalAlignment="Right" FontStyle="Italic" Opacity="0.7"/>
                        </Grid>
                    </StackPanel>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
