<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Projekt9.ViewModels"
             x:Class="Projekt9.Views.FormView"
             x:DataType="vm:FormViewModel">
    <UserControl.Resources>
        <SolidColorBrush x:Key="HeaderTeal" Color="#1F6E84"/>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*,Auto" Margin="0">
        <!-- Górny pasek: nazwa formularza + akcje -->
        <Border Grid.Row="0" Background="#0F2233" Padding="16,12">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="Nazwa formularza:" Foreground="White"
                               VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBox Width="280"
                             PlaceholderText="np. Wniosek - Jan Kowalski 2026"
                             Text="{Binding FormName}"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}"
                           Foreground="#B5F0C7" VerticalAlignment="Center"
                           Margin="10,0" TextWrapping="NoWrap"/>
                <Button Grid.Column="2" Content="💾 Zapisz do bazy"
                        Command="{Binding SaveCommand}"
                        Background="#1FAE6B" Foreground="White"
                        FontWeight="SemiBold" Padding="14,8"/>
                <Button Grid.Column="3" Content="← Powrót"
                        Command="{Binding BackCommand}" Padding="12,8"/>
            </Grid>
        </Border>

        <!-- Wniosek - zawartość --> 
        <ScrollViewer Grid.Row="1" Padding="40,24,40,0" Background="White"
                      VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Styles>
                <!-- Cały obszar "kartki" jest biały, więc wymuszamy ciemny tekst,
                     żeby działał także w ciemnym motywie systemowym. -->
                <Style Selector="TextBlock">
                    <Setter Property="Foreground" Value="#101010"/>
                </Style>
                <Style Selector="TextBox">
                    <Setter Property="Foreground" Value="#101010"/>
                    <Setter Property="Background" Value="#FFFFFF"/>
                    <Setter Property="BorderBrush" Value="#888888"/>
                    <Setter Property="CaretBrush" Value="#101010"/>
                    <Setter Property="SelectionBrush" Value="#1F6E84"/>
                    <Setter Property="SelectionForegroundBrush" Value="White"/>
                </Style>
                <Style Selector="ComboBox">
                    <Setter Property="Foreground" Value="#101010"/>
                    <Setter Property="Background" Value="#FFFFFF"/>
                    <Setter Property="BorderBrush" Value="#888888"/>
                </Style>
                <Style Selector="ComboBoxItem">
                    <Setter Property="Foreground" Value="#101010"/>
                </Style>
                <Style Selector="DatePicker">
                    <Setter Property="Foreground" Value="#101010"/>
                    <Setter Property="Background" Value="#FFFFFF"/>
                    <Setter Property="BorderBrush" Value="#888888"/>
                </Style>
                <Style Selector="DatePicker /template/ TextBlock">
                    <Setter Property="Foreground" Value="#101010"/>
                </Style>
            </ScrollViewer.Styles>
            <StackPanel MaxWidth="900" HorizontalAlignment="Center" Spacing="14">

                <!-- Nagłówek z uczelnią -->
                <Grid ColumnDefinitions="Auto,*">
                    <Border Grid.Column="0" Width="64" Height="64"
                            BorderBrush="{StaticResource HeaderTeal}" BorderThickness="2"
                            CornerRadius="32" VerticalAlignment="Top">
                        <TextBlock Text="PP" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource HeaderTeal}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="1"
                               Text="POLITECHNIKA POZNAŃSKA"
                               FontSize="32" FontWeight="Bold"
                               Foreground="{StaticResource HeaderTeal}"
                               VerticalAlignment="Center" Margin="14,0,0,0"/>
                </Grid>

                <!-- Górny prawy: Poznań, dnia (1) -->
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <TextBlock Text="Poznań, dnia" VerticalAlignment="Center"/>
                    <DatePicker SelectedDate="{Binding RequestDate}"/>
                </StackPanel>

                <!-- Dane studenta (2..5) -->
                <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto"
                      ColumnSpacing="14" RowSpacing="10" HorizontalAlignment="Left" Width="600">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="numer albumu"
                               VerticalAlignment="Center" FontStyle="Italic"/>
                    <TextBox  Grid.Row="0" Grid.Column="1" Text="{Binding AlbumNumber}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="nazwisko i imię"
                               VerticalAlignment="Center" FontStyle="Italic"/>
                    <TextBox  Grid.Row="1" Grid.Column="1" Text="{Binding FullName}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="semestr, rok"
                               VerticalAlignment="Center" FontStyle="Italic"/>
                    <TextBox  Grid.Row="2" Grid.Column="1" Text="{Binding SemesterYear}"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="kierunek i stopień studiów"
                               VerticalAlignment="Center" FontStyle="Italic" TextWrapping="Wrap"/>
                    <TextBox  Grid.Row="3" Grid.Column="1" Text="{Binding FieldAndDegree}"/>
                </Grid>

                <!-- Adresat -->
                <StackPanel HorizontalAlignment="Center" Margin="0,20,0,4">
                    <TextBlock Text="PRODZIEKAN WYDZIAŁU" FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="INFORMATYKI I TELEKOMUNIKACJI" FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="WNIOSEK O PRZEPROWADZENIE EGZAMINU KOMISYJNEGO"
                           FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10"/>

                <!-- Treść wniosku (6..9) -->
                <TextBlock Text="Proszę o umożliwienie mi przystąpienia do egzaminu komisyjnego z"
                           TextWrapping="Wrap"/>

                <Grid ColumnDefinitions="Auto,*,Auto,140" ColumnSpacing="8">
                    <TextBlock Grid.Column="0" Text="przedmiotu" VerticalAlignment="Center"/>
                    <TextBox  Grid.Column="1" Text="{Binding Subject}"/>
                    <TextBlock Grid.Column="2" Text="punkty"
                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                    <TextBox  Grid.Column="3" Text="{Binding Points}"/>
                </Grid>

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <TextBlock Grid.Column="0" Text="prowadzonego przez" VerticalAlignment="Center"/>
                    <TextBox  Grid.Column="1" Text="{Binding Lecturer}"/>
                </Grid>

                <StackPanel Spacing="6">
                    <TextBlock Text="Uzasadnienie wniosku:" FontWeight="Bold"/>
                    <TextBox AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="120" VerticalContentAlignment="Top"
                             Text="{Binding Justification}"/>
                </StackPanel>

                <!-- Data + podpis studenta (10) -->
                <StackPanel HorizontalAlignment="Right" Margin="0,16,0,0" Spacing="6">
                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                        <TextBlock Grid.Column="0" Text="Data:" VerticalAlignment="Center"/>
                        <DatePicker Grid.Column="1" SelectedDate="{Binding StudentSignDate}"/>
                        <TextBox Grid.Column="2" Width="260" MinWidth="220"
                                 PlaceholderText="podpis studenta"
                                 Text="{Binding StudentSignature}"/>
                    </Grid>
                    <TextBlock Text="data i podpis studenta"
                               FontStyle="Italic" HorizontalAlignment="Right"/>
                </StackPanel>

                <Border BorderBrush="Black" BorderThickness="0,1,0,0" Margin="0,18,0,4"/>

                <!-- DECYZJA (11..15) -->
                <TextBlock Text="DECYZJA" FontWeight="Bold" FontSize="18"
                           HorizontalAlignment="Center" TextDecorations="Underline"
                           Margin="0,8"/>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Decyzja prodziekana:" FontWeight="Bold" VerticalAlignment="Center"/>
                    <ComboBox SelectedIndex="{Binding DecisionApproved, Converter={x:Static vm:BoolToIndexConverter.Instance}}"
                              Width="240">
                        <ComboBoxItem Content="Wyrażam zgodę na przeprowadzenie egzaminu komisyjnego"/>
                        <ComboBoxItem Content="Nie wyrażam zgody na przeprowadzenie egzaminu komisyjnego"/>
                    </ComboBox>
                </StackPanel>

                <TextBlock Text="Skład komisji:" FontWeight="Bold" Margin="0,4,0,0"/>
                <Grid ColumnDefinitions="32,*" RowDefinitions="Auto,Auto,Auto"
                      ColumnSpacing="6" RowSpacing="8">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="1." VerticalAlignment="Center"/>
                    <TextBox  Grid.Row="0" Grid.Column="1" Text="{Binding CommitteeMember1}"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="2." VerticalAlignment="Center"/>
                    <TextBox  Grid.Row="1" Grid.Column="1" Text="{Binding CommitteeMember2}"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="3." VerticalAlignment="Center"/>
                    <TextBox  Grid.Row="2" Grid.Column="1" Text="{Binding CommitteeMember3}"/>
                </Grid>

                <Grid ColumnDefinitions="*,*" Margin="0,16,0,0">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Poznań, dnia" VerticalAlignment="Center"/>
                        <DatePicker SelectedDate="{Binding DecisionDate}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="Pieczątka i podpis"
                               FontStyle="Italic" HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"/>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- Stopka — duplikat akcji aby były pod ręką po przewinięciu -->
        <Border Grid.Row="2" Background="#F2F2F2" Padding="16,10">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"
                           Foreground="#101010"/>
                <Button Content="💾 Zapisz do bazy"
                        Command="{Binding SaveCommand}"
                        Background="#1FAE6B" Foreground="White"
                        FontWeight="SemiBold" Padding="14,8"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
