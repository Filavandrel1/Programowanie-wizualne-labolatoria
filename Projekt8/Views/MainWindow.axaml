<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Projekt8.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="500"
        x:Class="Projekt8.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="700" Height="500"
        WindowStartupLocation="CenterScreen"
        Title="Hub gier karcianych">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid Margin="20" RowDefinitions="Auto,*,Auto">

        <TextBlock Grid.Row="0"
                   Text="{Binding Title}"
                   FontSize="24" FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15"/>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding Games}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:GameItemViewModel">
                    <Border Width="180" Height="180" Margin="10"
                            BorderBrush="Gray" BorderThickness="1"
                            CornerRadius="6" Background="#F5F5F5">
                        <Grid RowDefinitions="*,Auto,Auto" Margin="10">
                            <TextBlock Grid.Row="0" Text="{Binding Name}"
                                       FontSize="18" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Text="{Binding Description}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Margin="0,4,0,8"/>
                            <Button Grid.Row="2" Content="Graj"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).PlayGameCommand}"
                                    CommandParameter="{Binding}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Grid.Row="2"
                   Text="{Binding StatusMessage}"
                   IsVisible="{Binding StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                   HorizontalAlignment="Center"
                   FontStyle="Italic"
                   Margin="0,10,0,0"/>

    </Grid>

</Window>
