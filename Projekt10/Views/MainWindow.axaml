<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Projekt10.ViewModels"
        xmlns:m="using:Projekt10.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="Projekt10.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1100" Height="700"
        Icon="/Assets/avalonia-logo.ico"
        Title="Projekt10 — Analizator sekwencji FASTA">

    <Window.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,4,8,4" />
        </Style>
        <Style Selector="TextBlock.value">
            <Setter Property="Margin" Value="0,4,0,4" />
        </Style>
        <Style Selector="Button.tool">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="12,6" />
        </Style>
    </Window.Styles>

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <DockPanel LastChildFill="True">

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="#F4F4F4" Padding="10" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button Classes="tool" Content="Wczytaj FASTA..." Command="{Binding LoadFilesCommand}" />
                <Button Classes="tool" Content="Wyczyść" Command="{Binding ClearSequencesCommand}" IsEnabled="{Binding HasSequences}" />
                <Separator Width="1" Background="#CCC" Margin="6,0" />
                <Button Classes="tool" Content="Eksport CSV" Command="{Binding ExportCsvCommand}" IsEnabled="{Binding HasSequences}" />
                <Button Classes="tool" Content="Eksport JSON" Command="{Binding ExportJsonCommand}" IsEnabled="{Binding HasSequences}" />
            </StackPanel>
        </Border>

        <!-- Statusbar -->
        <Border DockPanel.Dock="Bottom" Background="#F4F4F4" Padding="10,6" BorderBrush="#DDD" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusMessage}" />
        </Border>

        <Grid ColumnDefinitions="2*,3*">
            <!-- Left: Sequence list -->
            <Border Grid.Column="0" BorderBrush="#DDD" BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Text="Wczytane sekwencje" FontWeight="Bold" Padding="10,8" Background="#FAFAFA" />
                    <ListBox ItemsSource="{Binding Sequences}"
                             SelectedItem="{Binding SelectedSequence}"
                             Padding="4">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="m:FastaSequence">
                                <StackPanel Margin="4">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock FontSize="11" Foreground="#666">
                                        <Run Text="Długość: " />
                                        <Run Text="{Binding Length}" />
                                        <Run Text=" bp | Plik: " />
                                        <Run Text="{Binding SourceFile}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Right: Details + chart -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*">
                <!-- Details -->
                <Border Grid.Row="0" Padding="14" Background="#FAFAFA" BorderBrush="#DDD" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="Szczegóły wybranej sekwencji" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />

                        <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                              IsVisible="{Binding HasSelection}">
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Nazwa:" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Classes="value" Text="{Binding SelectedSequence.Name}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="Opis:" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Classes="value" Text="{Binding SelectedSequence.Description}" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="Plik źródłowy:" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Classes="value" Text="{Binding SelectedSequence.SourceFile}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Classes="label" Text="Długość:" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Classes="value">
                                <Run Text="{Binding SelectedSequence.Length}" />
                                <Run Text=" bp" />
                            </TextBlock>

                            <TextBlock Grid.Row="4" Grid.Column="0" Classes="label" Text="Zawartość GC:" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Classes="value">
                                <Run Text="{Binding SelectedSequence.GCContent}" />
                                <Run Text=" %" />
                            </TextBlock>

                            <TextBlock Grid.Row="5" Grid.Column="0" Classes="label" Text="Liczba kodonów:" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Classes="value" Text="{Binding SelectedSequence.CodonCount}" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Classes="label" Text="Liczba zasad:" />
                            <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Spacing="14" Margin="0,4">
                                <TextBlock>
                                    <Run Text="A: " FontWeight="SemiBold" />
                                    <Run Text="{Binding SelectedSequence.CountA}" />
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="T: " FontWeight="SemiBold" />
                                    <Run Text="{Binding SelectedSequence.CountT}" />
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="G: " FontWeight="SemiBold" />
                                    <Run Text="{Binding SelectedSequence.CountG}" />
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="C: " FontWeight="SemiBold" />
                                    <Run Text="{Binding SelectedSequence.CountC}" />
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="N: " FontWeight="SemiBold" />
                                    <Run Text="{Binding SelectedSequence.CountN}" />
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="inne: " FontWeight="SemiBold" />
                                    <Run Text="{Binding SelectedSequence.CountOther}" />
                                </TextBlock>
                            </StackPanel>

                            <TextBlock Grid.Row="7" Grid.Column="0" Classes="label" Text="Sekwencja (podgląd):" VerticalAlignment="Top" />
                            <Border Grid.Row="7" Grid.Column="1" BorderBrush="#DDD" BorderThickness="1" Background="White" Padding="6" Margin="0,4">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="80">
                                    <TextBlock Text="{Binding SelectedSequence.Sequence}" FontFamily="Consolas,Menlo,monospace" TextWrapping="Wrap" />
                                </ScrollViewer>
                            </Border>
                        </Grid>

                        <TextBlock Text="Wybierz sekwencję z listy, aby zobaczyć szczegóły."
                                   Foreground="#888" FontStyle="Italic"
                                   IsVisible="{Binding !HasSelection}" />
                    </StackPanel>
                </Border>

                <!-- Chart -->
                <Border Grid.Row="1" Padding="10">
                    <DockPanel LastChildFill="True">
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                            <TextBlock Grid.Column="0" Text="Wykres długości sekwencji" FontWeight="Bold" />
                            <TextBlock Grid.Column="1" Foreground="#666" FontSize="11">
                                <Run Text="Max: " />
                                <Run Text="{Binding ChartMaxLength}" />
                                <Run Text=" bp" />
                            </TextBlock>
                        </Grid>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <Border BorderBrush="#CCC" BorderThickness="0,0,0,1" Padding="0">
                                <ItemsControl ItemsSource="{Binding ChartBars}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:BarItem">
                                            <Grid Width="60" Margin="6,0" RowDefinitions="*,Auto,Auto">
                                                <Grid Grid.Row="0" VerticalAlignment="Bottom" Height="260">
                                                    <Rectangle Width="40"
                                                               Height="{Binding BarHeight}"
                                                               VerticalAlignment="Bottom"
                                                               Fill="SteelBlue"
                                                               Stroke="#2F5C84"
                                                               StrokeThickness="1" />
                                                    <TextBlock Text="{Binding Length}"
                                                               FontSize="10"
                                                               VerticalAlignment="Bottom"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,0,0,2"
                                                               Foreground="White" />
                                                </Grid>
                                                <Border Grid.Row="1" Height="1" Background="#888" Margin="0,2,0,2" />
                                                <TextBlock Grid.Row="2"
                                                           Text="{Binding Name}"
                                                           FontSize="11"
                                                           HorizontalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="60"
                                                           ToolTip.Tip="{Binding Name}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
